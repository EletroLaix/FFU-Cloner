{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Prepare FFU Cloner for debugging",
			"type": "process",
			"command": "node",
			"args": ["${workspaceFolder}/Scripts/PrepareDebug.cjs"],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"owner": "ffu-debug",
				"pattern": { "regexp": "^(FFU_DEBUG_ERROR): (.+)$", "file": 1, "message": 2 },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^Preparing FFU Cloner for debugging\\.\\.\\.$",
					"endsPattern": "^Elevated Electron started; Visual Studio Code can attach\\.$"
				}
			}
		}
	]
}
