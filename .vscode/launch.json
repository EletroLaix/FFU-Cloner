{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Electron main process",
			"type": "node",
			"request": "attach",
			"cwd": "${workspaceFolder}",
			"address": "127.0.0.1",
			"port": 9229,
			"timeout": 60000,
			"continueOnAttach": true,
			"presentation": { "hidden": true },
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "Electron renderer",
			"type": "chrome",
			"request": "attach",
			"port": 9223,
			"webRoot": "${workspaceFolder}",
			"timeout": 60000,
			"sourceMaps": true,
			"presentation": { "hidden": true }
		}
	],
	"compounds": [
		{
			"name": "Run and Debug FFU Cloner",
			"configurations": ["Electron main process", "Electron renderer"],
			"preLaunchTask": "Prepare FFU Cloner for debugging",
			"stopAll": true
		}
	]
}
