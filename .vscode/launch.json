{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Electron main process",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}",
			"runtimeExecutable": "${workspaceFolder}/node_modules/electron/dist/electron.exe",
			"args": [".", "--remote-debugging-port=9223"],
			"env": { "ELECTRON_RUN_AS_NODE": null },
			"console": "integratedTerminal",
			"presentation": { "hidden": true },
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "Electron renderer",
			"type": "chrome",
			"request": "attach",
			"port": 9223,
			"webRoot": "${workspaceFolder}",
			"timeout": 30000,
			"sourceMaps": true,
			"presentation": { "hidden": true }
		}
	],
	"compounds": [
		{
			"name": "Run and Debug FFU Cloner",
			"configurations": ["Electron main process", "Electron renderer"],
			"preLaunchTask": "Prepare FFU Cloner for debugging",
			"stopAll": true
		}
	]
}
